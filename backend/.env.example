DATABASE_URL=sqlite:///./pulse.db
SECRET_KEY=
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_ALLOWED_HOSTS=
# Opcional: ative e defina uma senha privada para habilitar a conta publica de portfolio.
DEMO_MODE=false
DEMO_USERNAME=demo
DEMO_EMAIL=
DEMO_PASSWORD=
# Worker separado; use o MESMO caminho em todos os processos ligados a este banco.
WORKER_LOCK_PATH=.worker.lock
# Nenhum email sai enquanto false. TLS obrigatorio (starttls ou ssl).
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# DATAPULSE_API_VENDAS=configure-somente-no-ambiente-local-ou-secret-manager
